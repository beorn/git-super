{
  "name": "git-super",
  "version": "0.1.0",
  "description": "Git commands that treat superprojects and submodule interiors as one product",
  "license": "MIT",
  "repository": "github:beorn/git-super",
  "bin": {
    "git-super": "bin/git-super"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./composition": "./src/composition.ts",
    "./commit-graph": "./src/commit-graph.ts",
    "./exclusive": "./src/exclusive.ts",
    "./gitlink": "./src/gitlink.ts",
    "./objects": "./src/objects.ts",
    "./process": "./src/process.ts",
    "./pull": "./src/pull.ts",
    "./push": "./src/push.ts",
    "./result": "./src/result.ts",
    "./submodules": "./src/submodules.ts",
    "./submodule-origin": "./src/submodule-origin.ts",
    "./worktree": "./src/worktree.ts"
  },
  "scripts": {
    "test": "bunx --bun vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "format": "oxfmt --check .",
    "fix": "oxfmt --write . && oxlint --fix src tests",
    "check": "bun run test && bun run typecheck && bun run lint && bun run format",
    "build": "tsdown"
  },
  "dependencies": {
    "@bearly/flock": "0.1.0",
    "@silvery/command": "0.23.2",
    "@silvery/commander": "0.23.2",
    "loggily": "^0.10.2",
    "react": "19.2.0",
    "silvery": "0.23.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "19.2.0",
    "oxfmt": "0.38.0",
    "oxlint": "1.71.0",
    "tsdown": "^0.15.7",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./composition": {
        "types": "./dist/composition.d.ts",
        "import": "./dist/composition.js"
      },
      "./commit-graph": {
        "types": "./dist/commit-graph.d.ts",
        "import": "./dist/commit-graph.js"
      },
      "./exclusive": {
        "types": "./dist/exclusive.d.ts",
        "import": "./dist/exclusive.js"
      },
      "./gitlink": {
        "types": "./dist/gitlink.d.ts",
        "import": "./dist/gitlink.js"
      },
      "./objects": {
        "types": "./dist/objects.d.ts",
        "import": "./dist/objects.js"
      },
      "./process": {
        "types": "./dist/process.d.ts",
        "import": "./dist/process.js"
      },
      "./pull": {
        "types": "./dist/pull.d.ts",
        "import": "./dist/pull.js"
      },
      "./push": {
        "types": "./dist/push.d.ts",
        "import": "./dist/push.js"
      },
      "./result": {
        "types": "./dist/result.d.ts",
        "import": "./dist/result.js"
      },
      "./submodules": {
        "types": "./dist/submodules.d.ts",
        "import": "./dist/submodules.js"
      },
      "./submodule-origin": {
        "types": "./dist/submodule-origin.d.ts",
        "import": "./dist/submodule-origin.js"
      },
      "./worktree": {
        "types": "./dist/worktree.d.ts",
        "import": "./dist/worktree.js"
      }
    }
  },
  "tsdown": {
    "entry": [
      "src/index.ts",
      "src/composition.ts",
      "src/commit-graph.ts",
      "src/exclusive.ts",
      "src/gitlink.ts",
      "src/objects.ts",
      "src/process.ts",
      "src/pull.ts",
      "src/push.ts",
      "src/result.ts",
      "src/submodules.ts",
      "src/submodule-origin.ts",
      "src/worktree.ts"
    ],
    "format": "esm",
    "dts": true,
    "clean": true
  }
}
